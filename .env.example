# Supabase PostgreSQL via the Supavisor SESSION pooler (IPv4, port 5432 — the
# direct db.<ref>.supabase.co host is IPv6-only on many networks/hosts).
# Pooler username is "postgres.<project-ref>". URL-encode special characters
# in the password (e.g. '@' -> %40). SSL is required.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Storage (server-side uses the secret key; never expose it client-side)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-service-secret-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production-please"
JWT_EXPIRES_IN="7d"
AUTH_COOKIE_NAME="xipra_admin_session"

# Seed (used only by prisma/seed.ts to create the first admin)
ADMIN_SEED_NAME="Xipra Admin"
ADMIN_SEED_EMAIL="admin@xipratech.com"
ADMIN_SEED_PASSWORD="ChangeMe@123"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Uploads (Supabase Storage)
MAX_UPLOAD_SIZE_MB="10"

# SMTP (Nodemailer). Leave blank to disable email sending (forms still store data).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Xipra Technology <no-reply@xipratechnology.com>"

MAIL_COMPANY_INTERNSHIP="info@xipratechnology.com"
MAIL_COMPANY_CONTACT="contact@xipratechnology.com"

COMPANY_NAME="Xipra Technology"
COMPANY_PHONE="+91 9033387254"
COMPANY_EMAIL="info@xipratechnology.com"
COMPANY_WEBSITE="https://xipratechnology.com"
